/* Z-Agent TUI — Textual CSS */

/* ── Global ──────────────────────────────────────────────────────── */
Screen {
    background: #1e1a1a;
    color: #fdfcfc;
}

/* ── Header ──────────────────────────────────────────────────────── */
#app-header {
    dock: top;
    height: 3;
    background: #1e1a1a;
    content-align: center middle;
    text-style: bold;
    color: #ff9f0a;
    border-bottom: solid #3c3838;
}

/* ── Main layout ─────────────────────────────────────────────────── */
#main-container {
    height: 1fr;
}

/* ── Chat area ───────────────────────────────────────────────────── */
#chat-area {
    width: 1fr;
    height: 1fr;
    background: #1e1a1a;
    overflow-y: auto;
    padding: 0 0;
}

#chat-scroll {
    height: auto;
    min-height: 100%;
}

/* ── Sidebar ─────────────────────────────────────────────────────── */
#sidebar {
    width: 32;
    height: 1fr;
    background: #1a1717;
    border-left: tall #3c3838;
    overflow-y: auto;
    padding: 1;
}

#sidebar StatusBar,
#sidebar CommandPalette,
#sidebar SessionInfo,
#sidebar UsageWidget {
    margin: 0 0 1 0;
}

/* ── Input area ──────────────────────────────────────────────────── */
#input-area {
    dock: bottom;
    height: auto;
    background: #1e1a1a;
    padding: 0 0 2 0;
    border-top: solid #3c3838;
}

/* Compact token bar — hanya muncul di layar sempit (mobile/Termux),
   menggantikan sidebar yang disembunyikan. */
#token-bar {
    display: none;
}

/* Layar sempit (<90 kolom, mis. Termux): sidebar disembunyikan biar chat
   full-width, digantikan bar status ringkas (token) di bawah input. */
.width-narrow #sidebar {
    display: none;
}

.width-narrow #token-bar {
    display: block;
}

.width-narrow #input-container {
    padding: 1 1;
}

/* Toggle manual Ctrl+B — diprioritaskan di atas rule lebar layar. */
.manual-mobile #sidebar {
    display: none;
}

.manual-mobile #token-bar {
    display: block;
}

.manual-mobile #input-container {
    padding: 1 1;
}

#input-container {
    height: 6;
    padding: 1 3;
    layout: horizontal;
}

#user-input {
    width: 1fr;
    height: 4;
    background: #262222;
    border: tall #3c3838;
    border-left: tall #30d158;
    color: #fdfcfc;
    padding: 0 1;
}

#user-input:focus {
    border: tall #ff9f0a;
    border-left: tall #30d158;
}

#user-input > .input--cursor {
    color: #ff9f0a;
}

/* ── Widget styles ───────────────────────────────────────────────── */
.status-title, .cmd-title, .session-title {
    text-style: bold;
    color: #ff9f0a;
    margin-bottom: 1;
}

.status-item, .cmd-item, .session-item {
    color: #9a9898;
    height: auto;
}

.cmd-item {
    padding: 0 0;
}

.think-on {
    color: #30d158;
    text-style: bold;
}

.think-off {
    color: #9a9898;
}

/* ── Loading indicator ───────────────────────────────────────────── */
#loading-indicator {
    height: 1;
    padding: 0 1;
    color: #9a9898;
    text-style: italic;
}

/* ── Scrollbar theming ───────────────────────────────────────────── */
#chat-area Scrollbar {
    background: #1e1a1a;
}

#chat-area ScrollbarThumb {
    background: #3c3838;
}

#chat-area ScrollbarThumb:hover {
    background: #504c4c;
}

/* ── Sidebar scrollbar ───────────────────────────────────────────── */
#sidebar Scrollbar {
    background: #1a1717;
}

#sidebar ScrollbarThumb {
    background: #3c3838;
}
